generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  debit
  credit
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  hashedPassword String
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  statements        Statement[]
  transactions      Transaction[]
  userCategoryRules UserCategoryRule[]
}

model VerificationToken {
  id        String                @id @default(cuid())
  email     String
  token     String
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([email])
}

model Statement {
  id        String    @id @default(cuid())
  userId    String
  bank      String
  fromDate  DateTime?
  toDate    DateTime?
  txnCount  Int
  createdAt DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  statementId String?
  date        DateTime
  description String
  reference   String          @default("")
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  balance     Decimal         @db.Decimal(12, 2)
  dedupHash   String          @unique
  categoryId  String?
  manualCategory Boolean      @default(false)
  isManual    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement Statement? @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date(sort: Desc)])
  @@index([statementId])
  @@index([userId, categoryId, manualCategory])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String
  colour    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  transactions      Transaction[]
  userCategoryRules UserCategoryRule[]
}

model UserCategoryRule {
  id         String   @id @default(cuid())
  userId     String
  keyword    String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
}
